{
  "name": "kronos-channel-stremio",
  "version": "5.10.5",
  "description": "Kronos channel addon configurator for Stremio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.js",
    "audit:manifest": "node scripts/audit-manifest-streams.js",
    "audit:assets": "node scripts/audit-channel-assets.js"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "express": "^4.19.2",
    "sax": "^1.6.0",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
